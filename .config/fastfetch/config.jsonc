{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "break",
    "break",
    // "title",
    // "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    // "packages",
    "shell",
    // "display",
    "de",
    "wm",
    // "wmtheme",
    // "theme",
    // "icons",
    // "font",
    // "cursor",
    // "terminal",
    // "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "break"
  ],
  "logo": {
    "type": "auto",        // Logo type: auto, builtin, small, file, etc.
    "source": "arch",      // Built-in logo name or file path
    "width": 20,           // Width in characters
    "height": 10,          // Height in characters
    "padding": {
        "top": 1,          // Top padding
        "left": 2,         // Left padding
        "right": 2         // Right padding
    },
    "color": {             // Override logo colors
         "1": "#eb4034",
         "2": "#eb4034"
     }
  },
  "display": {
    "separator": ": ",     // Separator between keys and values
    "color": {
        "keys": "#eb4034",    // Key color
        "title": "#eb4034"     // Title color
    },
    "key": {
        // "width": 12,       // Aligns keys to this width
        "type": "string"   // string, icon, both, or none
    },
    "bar": {
        "width": 10,       // Width of percentage bars
        "char": {
            "elapsed": "■", // Character for elapsed portion
            "total": "-"    // Character for total portion
        }
    },
    "percent": {
        "type": 2,         // 1=number, 2=bar, 3=both, 9=colored number
        "color": {
            "green": "#a6c777",
            "yellow": "#b5ac59",
            "red": "#b57359"
        }
    }
}
}
